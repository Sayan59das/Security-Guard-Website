# Copy this file to .env.local and fill in the values you need.
# Nothing here is required to run the site locally.

# --- Site -------------------------------------------------------------------
# Public URL of the deployed site, no trailing slash. Used for canonical URLs,
# Open Graph tags, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form email (Resend, https://resend.com) --------------------------
# API key from the Resend dashboard. If this is empty the form still works in
# development: each enquiry is printed to the server console instead of being
# emailed. In production an empty key makes the form return an error on purpose,
# so you never think leads are arriving when they are not.
RESEND_API_KEY=

# Where enquiries are delivered. Separate several addresses with commas.
CONTACT_TO_EMAIL=

# The "from" address. It must be on a domain you have verified in Resend.
# For a first test you can use Resend's sandbox sender: onboarding@resend.dev
# (the sandbox only delivers to the email address you signed up to Resend with).
CONTACT_FROM_EMAIL=onboarding@resend.dev
